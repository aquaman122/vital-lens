# Supabase 프로젝트 URL (Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# secret(service_role) key — 서버 전용. 브라우저에 노출 금지 (NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# 대시보드 HTTP Basic 인증. 프로덕션에서 비워두면 503으로 막힌다(개발 서버는 통과).
# Vercel Hobby는 Password Protection을 못 쓰므로 이 문이 유일한 보호막이다.
DASHBOARD_USER=vital-lens
DASHBOARD_PASSWORD=
